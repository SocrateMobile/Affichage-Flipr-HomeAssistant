# ==============================================================================
# Exemple de fichier secrets.yaml pour ESPHome
# À placer dans le dossier /config/esphome/ de votre Home Assistant
# ==============================================================================

# Clé de chiffrement API ESPHome (générée lors de la création du nœud dans ESPHome)
key_display_p: "votre_cle_chiffrement_api_esphome"

# Mot de passe pour les mises à jour sans fil (OTA)
ota_display_p: "votre_mot_de_passe_ota"

# Identifiants Wi-Fi de votre réseau local
wifi_ssid: "Mon_Reseau_WiFi"
wifi_password: "Mon_Mot_De_Passe_WiFi"

# Mot de passe du point d'accès de secours (AP Hotspot) en cas de perte Wi-Fi
mdp_hotspot: "Mon_Mot_De_Passe_Secours"

# Identifiants d'accès au serveur web embarqué de l'ESP32
server_username: "admin"
server_password: "Mon_Mot_De_Passe_Web"
